SET_PRINT_STATS_INFO TOTAL_LAYER=1
START_PRINT EXTRUDER_TEMP=220 BED_TEMP=55
G90
M83
G92 E0
SET_PRINT_STATS_INFO CURRENT_LAYER=1
EXCLUDE_OBJECT_START NAME=KAMP_REUSE_CONTAINED_B
G1 Z2.000 F1200
G1 X125.000 Y125.000 F9000
G1 Z0.200 F600
G1 X145.000 Y125.000 E0.748 F1800
G1 X145.000 Y145.000 E0.748
G1 X125.000 Y145.000 E0.748
G1 X125.000 Y125.000 E0.748
