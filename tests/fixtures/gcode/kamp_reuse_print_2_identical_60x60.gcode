G1 X144.550 Y125.450 E0.715 F1800
G1 X144.550 Y144.550 E0.715
G1 X125.450 Y144.550 E0.715
G1 X125.450 Y125.450 E0.715
EXCLUDE_OBJECT_END NAME=KAMP_REUSE_CONTAINED_B
