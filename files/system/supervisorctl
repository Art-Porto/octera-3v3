#!/bin/sh
# supervisorctl shim - by destinal 
# this is a fake supervisorctl that provides just enough information for moonraker to think it's the real thing.
# good enough to list the names of services in moonraker.conf, to say whether they're running or not (with false pids and times)
# and to start and stop them by name, finding and calling the matching init scripts. 
# installing: put this in in /usr/bin/supervisorctl and then in moonraker.conf in [machine] section, set  "provider: supervisord_cli"
#
# Octera changes (2026-11-05):
# - stop/restart take down the whole process tree of the service. The plugin
#   init scripts start a sh wrapper that runs python as a child, and
#   start-stop-daemon -K only kills the wrapper; the old python stayed alive
#   next to the new one (OctoEverywhere PID 1444).
# - restart waits for the old tree to be gone before starting.
# - "restart moonraker" runs detached. Moonraker runs this shim as its own
#   child and cancels its running commands while it shuts down, so the start
#   half never ran and Moonraker stayed down after an update (15:01:25).
#
#   The detached run gets "--detached" as an argument, never through the
#   environment: the Moonraker it starts would inherit the variable and its
#   next self-restart would run inline and die with it (v1.2.2, 15:28/15:31).
#   It logs its steps to /tmp/octera-supervisorctl.log.
#
# SHIM_INIT_DIR / SHIM_RUN_DIR / SHIM_PROC override the system paths (tests).

# The caller may run with a reduced PATH (setsid, usleep live in /usr/bin).
PATH="/bin:/sbin:/usr/bin:/usr/sbin${PATH:+:$PATH}"
export PATH
SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
DETACHED=0
if [ "$1" = "--detached" ]; then DETACHED=1; shift; fi
DETACH_LOG="${SHIM_DETACH_LOG:-/tmp/octera-supervisorctl.log}"

INIT_DIR="${SHIM_INIT_DIR:-/etc/init.d}"
RUN_DIR="${SHIM_RUN_DIR:-/var/run}"
PROC="${SHIM_PROC:-/proc}"

if [ -t 1 ]; then  # colorize only if we're on a terminal
  GREEN='\033[32m'
  RED='\033[31m'
  ENDCOLOR='\033[0m'
fi

get_services() {
  moonraker_pid="$(cat "$RUN_DIR"/moonraker.pid 2>/dev/null)"
  # if moonraker is running, get its config directory from its command line
  if [ -f "$RUN_DIR"/moonraker.pid ] && [ -d "$PROC"/"$moonraker_pid" ] ; then
    cmdline="$(tr '\0' '\n' < /proc/"$moonraker_pid"/cmdline)"
    moonraker_dir="$(echo $cmdline | awk -F'-d ' '{print $2}' | awk '{print $1}')"
    moonraker_conf="$moonraker_dir/config/moonraker.conf"
    # services="klipper moonraker $(awk '/managed_services:/ {print $2}' $moonraker_conf | sed 's/://')"
    # services=`(printf 'klipper\nmoonraker\n'; awk '/managed_services:/ {print $2}' $moonraker_conf | sed 's/://') | sort|uniq`
    services=$(ls -1 "$INIT_DIR"/S*|sed 's/.*\/S..//;s/_service$//')
    echo $services
  else
    echo "Error: Invalid or missing PID file $RUN_DIR/moonraker.pid" >&2
    exit 1
  fi
}

get_pid_file() {
  service="$1"
  [ $service == "klipper" ] && service="klippy"
  pid_file="$RUN_DIR/$service.pid"
  echo $pid_file
}

is_running() {
  service="$1"
  pid_file="$(get_pid_file "$service")"

  # Check for PID file
  if [ -f "$pid_file" ] && [ -d "$PROC/$(cat $pid_file)" ]; then
      return 0  # Running
  fi

  # Fallback to using pidof in case the service doesn't use pid files
  if pidof "$service" &>/dev/null; then
      return 0  # Running
  fi
  return 1  # Not running
}

print_process_status() {
  if is_running "$service"; then
    printf "%-33s$GREEN""RUNNING$ENDCOLOR\n" "$service"
  else
    printf "%-33s$RED""STOPPED$ENDCOLOR\n" "$service"
  fi
}

print_usage() {
  echo "supervisorctl shim - provide minimal support for moonraker so CrealityOS moonraker can start/stop without systemd"
  echo "Usage: $0 [command] <service>"
  echo "commands include status stop start restart"
} 

get_script_path() {
  service="$1"
  script_path="$(ls -1 "$INIT_DIR"/S[0-9][0-9]${service}_service "$INIT_DIR"/S[0-9][0-9]${service}* 2>/dev/null|head -1)"
  echo "$script_path"
}

children_of() { # children_of <pid>: pids whose parent is <pid>
  for stat in "$PROC"/[0-9]*/stat; do
    line="$(cat "$stat" 2>/dev/null)" || continue
    rest="${line##*) }"            # drop "pid (comm) ", comm may hold spaces
    ppid="$(echo "$rest" | cut -d' ' -f2)"
    if [ "$ppid" = "$1" ]; then
      child="${stat%/stat}"
      echo "${child##*/}"
    fi
  done
}

tree_of() { # tree_of <pid>: <pid> and all its descendants, never this shim
  [ "$1" = "$$" ] && return 0
  echo "$1"
  for child in $(children_of "$1"); do
    tree_of "$child"
  done
}

service_tree() { # service_tree <service>: the running tree of its pid file
  pid_file="$(get_pid_file "$1")"
  [ -f "$pid_file" ] || return 0
  pid="$(cat "$pid_file" 2>/dev/null)"
  [ -n "$pid" ] && [ -d "$PROC/$pid" ] && tree_of "$pid"
  return 0
}

reap() { # reap <pid...>: TERM what is still alive, wait up to 5 s, then KILL
  alive=""
  for p in "$@"; do [ -d "$PROC/$p" ] && alive="$alive $p"; done
  [ -n "$alive" ] || return 0
  kill $alive 2>/dev/null
  for i in $(seq 50); do
    left=""
    for p in $alive; do [ -d "$PROC/$p" ] && left="$left $p"; done
    [ -n "$left" ] || return 0
    usleep 100000
  done
  kill -9 $left 2>/dev/null
  return 0
}

stop() {
  service="$1"
  script_path="$(get_script_path $service)"
  # Check if the script exists and stop the service with all its children
  if [[ -f "$script_path" ]]; then
    tree="$(service_tree "$service")"
    "$script_path" stop
    reap $tree
  fi
}

start() {
  service="$1"
  script_path="$(get_script_path $service)"
  # Check if the script exists and start the service
  if [[ -f "$script_path" ]]; then
    "$script_path" start
  fi
}

log() { [ "$DETACHED" = 1 ] && echo "$(date +%T) $$ $*"; return 0; }

wait_running() { # wait_running <service>: up to 10 s for its pid file process
  for i in $(seq 100); do
    pid="$(cat "$(get_pid_file "$1")" 2>/dev/null)"
    [ -n "$pid" ] && [ -d "$PROC/$pid" ] && return 0
    usleep 100000
  done
  return 1
}

restart() {
  service="$1"
  script_path="$(get_script_path $service)"
  [[ -f "$script_path" ]] || return 0
  if [ "$service" = "moonraker" ] && [ "$DETACHED" = 0 ]; then
    # Moonraker runs this as its child and kills it while shutting down:
    # leave its process tree and let the caller return at once.
    ( setsid "$SELF" --detached restart moonraker </dev/null >"$DETACH_LOG" 2>&1 & )
    return 0
  fi
  if [ "$DETACHED" = 1 ]; then
    log "detached restart of $service"
    usleep 500000   # let the caller see us return
  fi
  stop "$service"
  log "stopped $service"
  start "$service"
  if [ "$DETACHED" = 1 ]; then
    if ! wait_running "$service"; then
      log "$service not running after start, retrying"
      start "$service"
      wait_running "$service" || log "$service still not running"
    fi
    log "started $service pid $(cat "$(get_pid_file "$service")" 2>/dev/null)"
  fi
}

main() {
  # echo "$0 $@" >> /tmp/supervisorctl.log
  action="$1"; shift
  case "$action" in
    status)
      if [ "$#" -lt 1 ]; then  # just status, no arguments
        for service in $(get_services); do
          print_process_status $service
        done
      else
        for service in "$@"; do # loop through the arguments provided
          print_process_status $service
        done
      fi
      ;;
    start)
      start "$1"
      ;;
    stop)
      stop "$1"
      ;;
    restart)
      restart "$1"
      ;;
    *)
      print_usage
      exit 1
  esac
}

main "$@"
